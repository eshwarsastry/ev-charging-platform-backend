{
  "name": "ohmcharge-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-shaped backend for EV charger discovery, trip planning and payment orchestration",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ],
    "overrides": {
      "fastify": "5.12.5"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --check \"{src,test,docs}/**/*.{ts,md}\" \"*.{json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"{src,test,docs}/**/*.{ts,md}\" \"*.{json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "^12.0.6",
    "@nestjs/testing": "^11.2.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
