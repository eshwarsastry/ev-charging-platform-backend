NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ohmcharge
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
ADMIN_API_KEY=replace-with-at-least-32-characters

# Google Maps Platform: enable Routes API. Never use a browser-restricted key here.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com

# Pulse Energy partner API / OCPI credentials (request sandbox access from Pulse Energy).
PULSE_ENERGY_ENABLED=false
PULSE_ENERGY_OCPI_BASE_URL=
PULSE_ENERGY_OCPI_TOKEN=

# IONAGE Discovery API / OCPI credentials (request Token A from IONAGE).
IONAGE_ENABLED=false
IONAGE_OCPI_BASE_URL=
IONAGE_OCPI_TOKEN=

# mock makes the PoC fully runnable. partner is blocked until an acquiring partner supplies specs.
FASTAG_MODE=mock
ENABLE_PAYMENT_SANDBOX=false
# Raw credential tokens (the client Base64-encodes the Authorization header).
# Add operator feeds after onboarding; baseUrl is the parent of /locations.
OCPI_PROVIDERS_JSON=[]
FASTAG_PARTNER_BASE_URL=
FASTAG_PARTNER_CLIENT_ID=
FASTAG_PARTNER_CLIENT_SECRET=
FASTAG_WEBHOOK_SECRET=replace-with-at-least-32-characters
